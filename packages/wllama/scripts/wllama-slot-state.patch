+  /**
+   * Save the state of a slot: its KV cache (and recurrent state, if any), its context checkpoints and its tokens, as llama-server's slot save file.
+   *
+   * Restore it with `restoreSlotState` into the same model, loaded with the same parameters and the same wllama build, to skip reading that prompt again, for example after a page reload. The state is only valid for that model: store it keyed by the model.
+   *
+   * Fails while a completion is running.
+   * @param idSlot The slot to save. By default, the slot of the last completion.
+   * @returns The state, as bytes
+   */
+  async saveSlotState(idSlot: number = -1): Promise<Uint8Array> {
+    this.checkModelLoaded();
+    const result = await this.proxy.wllamaAction<GlueMsgSlotSaveRes>(
+      'slot_save',
+      { _name: 'slsv_req', id_slot: idSlot }
+    );
+    if (!result.success) {
+      throw new WllamaError(
+        `Failed to save slot ${result.id_slot}: ${result.message}`,
+        'inference_error'
+      );
+    }
+    return result.data;
+  }
+
+  /**
+   * Restore a slot state saved with `saveSlotState`.
+   *
+   * The next completion reuses the restored state as far as its prompt starts with the same tokens, as with any cached prompt, so a state that doesn't match the prompt only means no reuse.
+   *
+   * Fails while a completion is running, or if the state doesn't fit the loaded model and context.
+   * @param data The state, from `saveSlotState`
+   * @param idSlot The slot to restore into. By default, the slot of the last completion, or slot 0 before any.
+   * @returns The number of tokens restored
+   */
+  async restoreSlotState(
+    data: Uint8Array,
+    idSlot: number = -1
+  ): Promise<number> {
+    this.checkModelLoaded();
+    const result = await this.proxy.wllamaAction<GlueMsgSlotRestoreRes>(
+      'slot_restore',
+      { _name: 'slrs_req', id_slot: idSlot, data }
+    );
+    if (!result.success) {
+      throw new WllamaError(
+        `Failed to restore slot ${result.id_slot}: ${result.message}`,
+        'inference_error'
+      );
+    }
+    return result.n_tokens;
+  }
