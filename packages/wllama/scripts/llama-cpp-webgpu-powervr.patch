+           src1->nb[0] == ggml_type_size(src1->type) && src0->nb[0] == ggml_type_size(src0->type) &&
+           dst->nb[0] == ggml_type_size(dst->type) && dst->nb[1] == dst->ne[0] * ggml_type_size(dst->type) &&
