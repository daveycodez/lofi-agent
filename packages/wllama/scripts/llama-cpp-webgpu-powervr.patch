diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl
@@ -0,0 +1,34 @@
+// Copies the src1 of a mat-vec or mat-mat into a buffer of its own, columns
+// packed, so that mul_mat_vec_pvr.wgsl, mul_mat_pvr.wgsl and
+// mul_mat_pvr_gemm.wgsl can bind it read-only (see there). OUT_F16 packs it
+// as f16 pairs, for mul_mat_pvr_gemm.wgsl.
+
+struct Params {
+    offset_src: u32,
+    k: u32,
+    stride_src: u32,  // elements between columns
+    n: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src: array<f32>;
+#ifdef OUT_F16
+@group(0) @binding(1) var<storage, read_write> staged: array<u32>;
+#else
+@group(0) @binding(1) var<storage, read_write> staged: array<f32>;
+#endif
+@group(0) @binding(2) var<uniform> params: Params;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+#ifdef OUT_F16
+    // one f16 pair per thread
+    if (2u * gid.x < params.k && gid.y < params.n) {
+        let s = params.offset_src + gid.y * params.stride_src + 2u * gid.x;
+        staged[gid.y * (params.k / 2u) + gid.x] = pack2x16float(vec2<f32>(src[s], src[s + 1u]));
+    }
+#else
+    if (gid.x < params.k && gid.y < params.n) {
+        staged[gid.y * params.k + gid.x] = src[params.offset_src + gid.y * params.stride_src + gid.x];
+    }
+#endif
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl
@@ -0,0 +1,233 @@
+// Mat-vec for Imagination PowerVR GPUs (Q4_K, Q6_K): one column, or NCOL
+// columns at once for the few tokens at the end of a prompt (the weights,
+// which bound the time, are read once for all of them).
+//
+// On these GPUs, reading through a read_write storage binding is several
+// times slower than through a read-only one, so the weights are bound
+// read-only (SRC0_RO, when they sit in a different buffer than dst) and the
+// vector is read from a read-only copy (mul_mat_pvr_stage.wgsl). Each
+// group of TPR threads handles one row, and neighbouring lanes load
+// neighbouring 16-byte words of a block.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_RO
+#define SRC0_ACCESS read
+#else
+#define SRC0_ACCESS read_write
+#endif
+
+#ifdef Q4_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<vec4<u32>>;
+#endif
+#ifdef Q6_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<u32>;
+#endif
+@group(0) @binding(1) var<storage, read> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const TPR = WG_SIZE / ROWS_PER_WG;
+
+var<workgroup> partial_sums: array<f32, WG_SIZE * NCOL>;
+
+#ifdef Q4_K
+// 144-byte blocks = 9 vec4<u32>: [0] = d, dmin, scales[12]; [1..8] = qs.
+// LPB lanes share a block; a lane handles qs words pg and pg + 4.
+const LPB = 4u;
+
+// the qs word p of a block, unpacked: low nibbles (values 64 jj + 16 (p & 1) + 0..15) in l, high in h
+struct Q4Piece {
+    l0: vec4<f32>, l1: vec4<f32>, l2: vec4<f32>, l3: vec4<f32>,
+    h0: vec4<f32>, h1: vec4<f32>, h2: vec4<f32>, h3: vec4<f32>,
+    // d * scale * 255 and dmin * min of the low (xy) and high (zw) sub-blocks
+    sc: vec4<f32>,
+};
+
+fn q4k_unpack(bb: u32, p: u32, A: u32, B: u32, C: u32, dm: vec2<f32>) -> Q4Piece {
+    let q = src0[bb + 1u + p];
+    let jj = p >> 1u;
+    // scales and mins of sub-blocks 2jj (low nibbles) and 2jj + 1 (high nibbles)
+    let s = 2u * jj;
+    let sha = 8u * (s & 3u);
+    let shb = sha + 8u;
+    var sc1: u32;
+    var m1: u32;
+    var sc2: u32;
+    var m2: u32;
+    if (s >= 4u) {
+        sc1 = ((C >> sha) & 0xFu) | (((A >> sha) >> 2u) & 0x30u);
+        m1  = (((C >> sha) >> 4u) & 0xFu) | (((B >> sha) >> 2u) & 0x30u);
+        sc2 = ((C >> shb) & 0xFu) | (((A >> shb) >> 2u) & 0x30u);
+        m2  = (((C >> shb) >> 4u) & 0xFu) | (((B >> shb) >> 2u) & 0x30u);
+    } else {
+        sc1 = (A >> sha) & 63u;
+        m1  = (B >> sha) & 63u;
+        sc2 = (A >> shb) & 63u;
+        m2  = (B >> shb) & 63u;
+    }
+    // unpack4x8unorm divides by 255
+    return Q4Piece(unpack4x8unorm(q.x & 0x0F0F0F0Fu), unpack4x8unorm(q.y & 0x0F0F0F0Fu),
+                   unpack4x8unorm(q.z & 0x0F0F0F0Fu), unpack4x8unorm(q.w & 0x0F0F0F0Fu),
+                   unpack4x8unorm((q.x >> 4u) & 0x0F0F0F0Fu), unpack4x8unorm((q.y >> 4u) & 0x0F0F0F0Fu),
+                   unpack4x8unorm((q.z >> 4u) & 0x0F0F0F0Fu), unpack4x8unorm((q.w >> 4u) & 0x0F0F0F0Fu),
+                   vec4<f32>(dm.x * 255.0 * f32(sc1), dm.y * f32(m1), dm.x * 255.0 * f32(sc2), dm.y * f32(m2)));
+}
+
+// the piece against one column; xb is the column's block start
+fn q4k_col(w: Q4Piece, xb: u32, p: u32) -> f32 {
+    let xo = xb + (p >> 1u) * 16u + (p & 1u) * 4u;
+    let xl0 = src1[xo];
+    let xl1 = src1[xo + 1u];
+    let xl2 = src1[xo + 2u];
+    let xl3 = src1[xo + 3u];
+    let xh0 = src1[xo + 8u];
+    let xh1 = src1[xo + 9u];
+    let xh2 = src1[xo + 10u];
+    let xh3 = src1[xo + 11u];
+    let sl = w.l0 * xl0 + w.l1 * xl1 + w.l2 * xl2 + w.l3 * xl3;
+    let sh = w.h0 * xh0 + w.h1 * xh1 + w.h2 * xh2 + w.h3 * xh3;
+    let one = vec4<f32>(1.0);
+    return w.sc.x * dot(sl, one) + w.sc.z * dot(sh, one) - w.sc.y * dot(xl0 + xl1 + xl2 + xl3, one) -
+           w.sc.w * dot(xh0 + xh1 + xh2 + xh3, one);
+}
+
+// block b of a row against the NCOL columns (xb: column 0's block start, xs: elements / 4 between columns)
+fn block_dot(row_block: u32, b: u32, xb: u32, xs: u32, pg: u32) -> array<f32, NCOL> {
+    let bb = (row_block + b) * 9u;
+    let hdr = src0[bb];
+    let dm = unpack2x16float(hdr.x);
+    let w0 = q4k_unpack(bb, pg, hdr.y, hdr.z, hdr.w, dm);
+    let w1 = q4k_unpack(bb, pg + 4u, hdr.y, hdr.z, hdr.w, dm);
+    var r: array<f32, NCOL>;
+    for (var c = 0u; c < NCOL; c++) {
+        let x = xb + c * xs;
+        r[c] = q4k_col(w0, x, pg) + q4k_col(w1, x, pg + 4u);
+    }
+    return r;
+}
+#endif
+
+#ifdef Q6_K
+// 210-byte blocks: ql[128], qh[64], scales[16] (i8), d (f16). Blocks are only
+// 2-byte aligned. 8 lanes share a block, each handling 32 values.
+const LPB = 8u;
+
+// the 32-bit word at a 2-byte aligned byte offset
+fn ld(byte: u32) -> u32 {
+    let i = byte >> 2u;
+    let lo = src0[i];
+    let hi = src0[i + 1u];
+    return select((lo >> 16u) | (hi << 16u), lo, (byte & 2u) == 0u);
+}
+
+fn sbyte(w: u32, i: u32) -> f32 {
+    return f32(bitcast<i32>(w << (24u - 8u * i)) >> 24u);
+}
+
+// 4 values (6-bit, biased by 32) times 4 x values
+fn grp(q: u32, x: vec4<f32>) -> f32 {
+    return dot(unpack4x8unorm(q), x) * 255.0 - 32.0 * (x.x + x.y + x.z + x.w);
+}
+
+// block b of a row against the NCOL columns (xb: column 0's block start, xs: elements / 4 between columns)
+fn block_dot(row_block: u32, b: u32, xb: u32, xs: u32, p: u32) -> array<f32, NCOL> {
+    let base = (row_block + b) * 210u;
+    let n = p >> 2u;
+    let l0 = 8u * (p & 3u);
+    let a0 = ld(base + 64u * n + l0);
+    let a1 = ld(base + 64u * n + l0 + 4u);
+    let b0 = ld(base + 64u * n + l0 + 32u);
+    let b1 = ld(base + 64u * n + l0 + 36u);
+    let h0 = ld(base + 128u + 32u * n + l0);
+    let h1 = ld(base + 132u + 32u * n + l0);
+    let scw0 = ld(base + 192u + 8u * n);
+    let scw1 = ld(base + 196u + 8u * n);
+    let od = l0 >> 4u;
+    let d = unpack2x16float(ld(base + 208u) & 0xFFFFu).x;
+    let s0 = d * sbyte(scw0, od);
+    let s1 = d * sbyte(scw0, 2u + od);
+    let s2 = d * sbyte(scw1, od);
+    let s3 = d * sbyte(scw1, 2u + od);
+    let qa0 = (a0 & 0x0F0F0F0Fu) | ((h0 << 4u) & 0x30303030u);
+    let qa1 = (a1 & 0x0F0F0F0Fu) | ((h1 << 4u) & 0x30303030u);
+    let qb0 = (b0 & 0x0F0F0F0Fu) | ((h0 << 2u) & 0x30303030u);
+    let qb1 = (b1 & 0x0F0F0F0Fu) | ((h1 << 2u) & 0x30303030u);
+    let qc0 = ((a0 >> 4u) & 0x0F0F0F0Fu) | (h0 & 0x30303030u);
+    let qc1 = ((a1 >> 4u) & 0x0F0F0F0Fu) | (h1 & 0x30303030u);
+    let qd0 = ((b0 >> 4u) & 0x0F0F0F0Fu) | ((h0 >> 2u) & 0x30303030u);
+    let qd1 = ((b1 >> 4u) & 0x0F0F0F0Fu) | ((h1 >> 2u) & 0x30303030u);
+    var r: array<f32, NCOL>;
+    for (var c = 0u; c < NCOL; c++) {
+        let x0 = xb + c * xs + 32u * n + (l0 >> 2u);
+        r[c] = s0 * (grp(qa0, src1[x0]) + grp(qa1, src1[x0 + 1u])) + s1 * (grp(qb0, src1[x0 + 8u]) + grp(qb1, src1[x0 + 9u])) +
+               s2 * (grp(qc0, src1[x0 + 16u]) + grp(qc1, src1[x0 + 17u])) +
+               s3 * (grp(qd0, src1[x0 + 24u]) + grp(qd1, src1[x0 + 25u]));
+    }
+    return r;
+}
+#endif
+
+const BLOCKS_PER_ITER = TPR / LPB;
+const_assert BLOCKS_PER_ITER > 0u;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(local_invocation_index) li: u32,
+        @builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let t = li % TPR;
+    let row = wg_linear * ROWS_PER_WG + li / TPR;
+    let nb = params.k / 256u;
+    // rows past the end compute on the last row and store nothing
+    let row_block = params.offset_src0 + min(row, params.m - 1u) * params.stride_01;
+    let x0 = params.offset_src1 / 4u;
+    let xs = params.k / 4u;  // between columns of the staged src1
+    let lane = t % LPB;
+
+    var acc: array<f32, NCOL>;
+    for (var b = t / LPB; b < nb; b += BLOCKS_PER_ITER) {
+        let r = block_dot(row_block, b, x0 + b * 64u, xs, lane);
+        for (var c = 0u; c < NCOL; c++) {
+            acc[c] += r[c];
+        }
+    }
+
+    for (var c = 0u; c < NCOL; c++) {
+        partial_sums[c * WG_SIZE + li] = acc[c];
+    }
+    workgroupBarrier();
+    for (var s = TPR / 2u; s > 0u; s >>= 1u) {
+        if (t < s) {
+            for (var c = 0u; c < NCOL; c++) {
+                partial_sums[c * WG_SIZE + li] += partial_sums[c * WG_SIZE + li + s];
+            }
+        }
+        workgroupBarrier();
+    }
+    if (t == 0u && row < params.m) {
+        // columns past n (NCOL rounds n up) are not stored
+        for (var c = 0u; c < NCOL; c++) {
+            if (c < params.n) {
+                dst[params.offset_dst + c * params.m + row] = partial_sums[c * WG_SIZE + li];
+            }
+        }
+    }
+}
