+    const size_t   staged_bytes = ROUNDUP_POW2((size_t) k * n * (gemm ? sizeof(ggml_fp16_t) : sizeof(float)), 16);
+    if (!ctx->pvr_staging_buf || ctx->pvr_staging_size < staged_bytes) {
+        ctx->pvr_staged_src1 = nullptr;
+        ggml_webgpu_pvr_scratch(ctx, ctx->pvr_staging_buf, ctx->pvr_staging_size, staged_bytes, "pvr_staging_buf");
+    }
+
+    std::vector<webgpu_dispatch_desc> dispatches;
