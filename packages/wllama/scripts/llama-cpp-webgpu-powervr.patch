+    let k_step = params.stride_k1 / 8u;
+    let v_step = params.stride_v1 / 8u;
+    let mask_row = params.offset_mask + qi * params.stride_mask1;
+    let last = params.n_kv - 1u;
+
+    for (var j = 0u; j < params.n_kv; j += 4u) {
+        let jv = min(vec4<u32>(j, j + 1u, j + 2u, j + 3u), vec4<u32>(last));
+        // mask (or -inf past the end) of positions j .. j + 3
+        var mk = vec4<f32>(0.0);
+#ifdef HAS_MASK
+        mk = vec4<f32>(f32(mask[mask_row + jv.x]), f32(mask[mask_row + jv.y]), f32(mask[mask_row + jv.z]),
+                       f32(mask[mask_row + jv.w]));
+#endif
+        mk = select(mk, vec4<f32>(NEG_BIG), vec4<u32>(j, j + 1u, j + 2u, j + 3u) > vec4<u32>(last));
+        let hidden = all(mk <= vec4<f32>(NEG_BIG));
+#if SPLIT > 1
+        if (subgroupAll(hidden)) {
+            continue;
+        }
+#else
+        if (hidden) {
+            continue;
+        }
+#endif
+        let kb = k_head + jv * k_step;
+        var s = vec4<f32>(0.0);
+        for (var i = 0u; i < NC; i++) {
+            let c = SPLIT * i;
+            let k0 = k[kb.x + c];
+            let k1 = k[kb.y + c];
+            let k2 = k[kb.z + c];
+            let k3 = k[kb.w + c];
+            s += vec4<f32>(dot(ql[i], lo(k0)) + dot(qh[i], hi(k0)), dot(ql[i], lo(k1)) + dot(qh[i], hi(k1)),
+                           dot(ql[i], lo(k2)) + dot(qh[i], hi(k2)), dot(ql[i], lo(k3)) + dot(qh[i], hi(k3)));
+        }
+#if SPLIT > 1
+        s += subgroupShuffleXor(s, 1u);
+#endif
+#if SPLIT > 2
+        s += subgroupShuffleXor(s, 2u);
+#endif
+        s += mk;
+        let m_new = max(m, max(max(s.x, s.y), max(s.z, s.w)));
+        let corr = exp(m - m_new);
+        let p = select(exp(s - vec4<f32>(m_new)), vec4<f32>(0.0), mk <= vec4<f32>(NEG_BIG));
+        l = l * corr + p.x + p.y + p.z + p.w;
+        m = m_new;
+        let vb = v_head + jv * v_step;
+        for (var i = 0u; i < NC; i++) {
+            let c = SPLIT * i;
+            let v0 = v[vb.x + c];
+            let v1 = v[vb.y + c];
+            let v2 = v[vb.z + c];
+            let v3 = v[vb.w + c];
+            ol[i] = ol[i] * corr + p.x * lo(v0) + p.y * lo(v1) + p.z * lo(v2) + p.w * lo(v3);
+            oh[i] = oh[i] * corr + p.x * hi(v0) + p.y * hi(v1) + p.z * hi(v2) + p.w * hi(v3);
+        }
+    }
+
+    if (row < params.n_q) {
+        // a row the mask hides entirely gets zeros
+        let inv_l = select(1.0 / l, 0.0, l == 0.0);
+        let d = params.offset_dst + (row * params.n_heads + h) * HEAD_DIM + 8u * part;
+        for (var i = 0u; i < NC; i++) {
+            let b = d + 8u * SPLIT * i;
+            let a = ol[i] * inv_l;
+            let c = oh[i] * inv_l;
+            dst[b] = a.x;
+            dst[b + 1u] = a.y;
+            dst[b + 2u] = a.z;
+            dst[b + 3u] = a.w;
+            dst[b + 4u] = c.x;
+            dst[b + 5u] = c.y;
+            dst[b + 6u] = c.z;
+            dst[b + 7u] = c.w;
+        }
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl
@@ -0,0 +1,215 @@
+// Mat-mat (prompt batches) for Imagination PowerVR GPUs (Q4_K, Q6_K).
+//
+// The tiled shaders stage both operands in workgroup memory, which is slow
+// there, and read through read_write bindings, which PowerVR reads several
+// times slower than read-only ones. Here each thread computes a 2x2 block of
+// dst straight from read-only bindings: the weights (SRC0_RO, when they are
+// in another buffer than dst) and a copy of src1 (mul_mat_pvr_stage.wgsl).
+// The 8x8 threads of a workgroup cover 16 rows and 16 columns, rows and
+// columns interleaved by 8. Larger blocks per thread run slower.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_RO
+#define SRC0_ACCESS read
+#else
+#define SRC0_ACCESS read_write
+#endif
+
+#ifdef Q4_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<vec4<u32>>;
+#endif
+#ifdef Q6_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<u32>;
+#endif
+@group(0) @binding(1) var<storage, read> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const LANES = 8u;          // threads along rows and along columns
+const TILE = 2u * LANES;   // rows (and columns) per workgroup
+
+#ifdef Q4_K
+// 144-byte blocks = 9 vec4<u32>: [0] = d, dmin, scales[12]; [1..8] = qs.
+
+// d * scale * 255 and dmin * min of sub-blocks 2jj (xy) and 2jj + 1 (zw)
+fn q4k_scales(h: vec4<u32>, jj: u32) -> vec4<f32> {
+    let dm = unpack2x16float(h.x);
+    let A = h.y;
+    let B = h.z;
+    let C = h.w;
+    let s = 2u * jj;
+    let sha = 8u * (s & 3u);
+    let shb = sha + 8u;
+    var sc1: u32;
+    var m1: u32;
+    var sc2: u32;
+    var m2: u32;
+    if (s >= 4u) {
+        sc1 = ((C >> sha) & 0xFu) | (((A >> sha) >> 2u) & 0x30u);
+        m1  = (((C >> sha) >> 4u) & 0xFu) | (((B >> sha) >> 2u) & 0x30u);
+        sc2 = ((C >> shb) & 0xFu) | (((A >> shb) >> 2u) & 0x30u);
+        m2  = (((C >> shb) >> 4u) & 0xFu) | (((B >> shb) >> 2u) & 0x30u);
+    } else {
+        sc1 = (A >> sha) & 63u;
+        m1  = (B >> sha) & 63u;
+        sc2 = (A >> shb) & 63u;
+        m2  = (B >> shb) & 63u;
+    }
+    // unpack4x8unorm divides by 255
+    return vec4<f32>(dm.x * f32(sc1) * 255.0, dm.y * f32(m1), dm.x * f32(sc2) * 255.0, dm.y * f32(m2));
+}
+
+// one qs word of rows 0 and 1 (4 low-nibble and 4 high-nibble values each)
+// against 4 + 4 values of columns 0 and 1: deltas for (r0c0, r0c1, r1c0, r1c1)
+fn q4k_step(qa: u32, qb: u32, s0: vec4<f32>, s1: vec4<f32>, xl0: vec4<f32>, xh0: vec4<f32>, xl1: vec4<f32>,
+            xh1: vec4<f32>) -> vec4<f32> {
+    let wl0 = unpack4x8unorm(qa & 0x0F0F0F0Fu) * s0.x - s0.y;
+    let wh0 = unpack4x8unorm((qa >> 4u) & 0x0F0F0F0Fu) * s0.z - s0.w;
+    let wl1 = unpack4x8unorm(qb & 0x0F0F0F0Fu) * s1.x - s1.y;
+    let wh1 = unpack4x8unorm((qb >> 4u) & 0x0F0F0F0Fu) * s1.z - s1.w;
+    return vec4<f32>(dot(wl0, xl0) + dot(wh0, xh0), dot(wl0, xl1) + dot(wh0, xh1), dot(wl1, xl0) + dot(wh1, xh0),
+                     dot(wl1, xl1) + dot(wh1, xh1));
+}
+
+fn row_block_dot(rb0: u32, rb1: u32, b: u32, xb0: u32, xb1: u32) -> vec4<f32> {
+    let bb0 = (rb0 + b) * 9u;
+    let bb1 = (rb1 + b) * 9u;
+    let h0 = src0[bb0];
+    let h1 = src0[bb1];
+    var acc = vec4<f32>(0.0);
+    for (var p = 0u; p < 8u; p++) {
+        let jj = p >> 1u;
+        let q0 = src0[bb0 + 1u + p];
+        let q1 = src0[bb1 + 1u + p];
+        let s0 = q4k_scales(h0, jj);
+        let s1 = q4k_scales(h1, jj);
+        // qs bytes 16p..16p+15: values 64jj + l (low nibbles) and 64jj + 32 + l (high)
+        let xo0 = xb0 + b * 64u + jj * 16u + (p & 1u) * 4u;
+        let xo1 = xb1 + b * 64u + jj * 16u + (p & 1u) * 4u;
+        acc += q4k_step(q0.x, q1.x, s0, s1, src1[xo0], src1[xo0 + 8u], src1[xo1], src1[xo1 + 8u]);
+        acc += q4k_step(q0.y, q1.y, s0, s1, src1[xo0 + 1u], src1[xo0 + 9u], src1[xo1 + 1u], src1[xo1 + 9u]);
+        acc += q4k_step(q0.z, q1.z, s0, s1, src1[xo0 + 2u], src1[xo0 + 10u], src1[xo1 + 2u], src1[xo1 + 10u]);
+        acc += q4k_step(q0.w, q1.w, s0, s1, src1[xo0 + 3u], src1[xo0 + 11u], src1[xo1 + 3u], src1[xo1 + 11u]);
+    }
+    return acc;
+}
+#endif
+
+#ifdef Q6_K
+// 210-byte blocks: ql[128], qh[64], scales[16] (i8), d (f16), only 2-byte aligned.
+
+// the 32-bit word at a 2-byte aligned byte offset
+fn ld(byte: u32) -> u32 {
+    let i = byte >> 2u;
+    let lo = src0[i];
+    let hi = src0[i + 1u];
+    return select((lo >> 16u) | (hi << 16u), lo, (byte & 2u) == 0u);
+}
+
+fn sbyte(w: u32, i: u32) -> f32 {
+    return f32(bitcast<i32>(w << (24u - 8u * i)) >> 24u);
+}
+
+// 4 values (6 bits, biased by 32) of rows 0 and 1 against 4 values of
+// columns 0 and 1, with scales s0 and s1 (times d): (r0c0, r0c1, r1c0, r1c1)
+fn q6k_step(qa: u32, qb: u32, s0: f32, s1: f32, x0: vec4<f32>, x1: vec4<f32>) -> vec4<f32> {
+    let w0 = (unpack4x8unorm(qa) * 255.0 - 32.0) * s0;
+    let w1 = (unpack4x8unorm(qb) * 255.0 - 32.0) * s1;
+    return vec4<f32>(dot(w0, x0), dot(w0, x1), dot(w1, x0), dot(w1, x1));
+}
+
+fn row_block_dot(rb0: u32, rb1: u32, b: u32, xb0: u32, xb1: u32) -> vec4<f32> {
+    let base0 = (rb0 + b) * 210u;
+    let base1 = (rb1 + b) * 210u;
+    let d0 = unpack2x16float(ld(base0 + 208u) & 0xFFFFu).x;
+    let d1 = unpack2x16float(ld(base1 + 208u) & 0xFFFFu).x;
+    var acc = vec4<f32>(0.0);
+    for (var n = 0u; n < 2u; n++) {
+        // scales 8n .. 8n + 7
+        let sc00 = ld(base0 + 192u + 8u * n);
+        let sc01 = ld(base0 + 196u + 8u * n);
+        let sc10 = ld(base1 + 192u + 8u * n);
+        let sc11 = ld(base1 + 196u + 8u * n);
+        for (var w = 0u; w < 8u; w++) {
+            let l0 = 4u * w;
+            let od = w >> 2u;  // l0 / 16
+            let a0 = ld(base0 + 64u * n + l0);
+            let b0 = ld(base0 + 64u * n + l0 + 32u);
+            let h0 = ld(base0 + 128u + 32u * n + l0);
+            let a1 = ld(base1 + 64u * n + l0);
+            let b1 = ld(base1 + 64u * n + l0 + 32u);
+            let h1 = ld(base1 + 128u + 32u * n + l0);
+            let xo0 = xb0 + b * 64u + 32u * n + w;
+            let xo1 = xb1 + b * 64u + 32u * n + w;
+            // y[l], y[l + 32], y[l + 64], y[l + 96] of this half
+            acc += q6k_step((a0 & 0x0F0F0F0Fu) | ((h0 << 4u) & 0x30303030u),
+                            (a1 & 0x0F0F0F0Fu) | ((h1 << 4u) & 0x30303030u), d0 * sbyte(sc00, od),
+                            d1 * sbyte(sc10, od), src1[xo0], src1[xo1]);
+            acc += q6k_step((b0 & 0x0F0F0F0Fu) | ((h0 << 2u) & 0x30303030u),
+                            (b1 & 0x0F0F0F0Fu) | ((h1 << 2u) & 0x30303030u), d0 * sbyte(sc00, 2u + od),
+                            d1 * sbyte(sc10, 2u + od), src1[xo0 + 8u], src1[xo1 + 8u]);
+            acc += q6k_step(((a0 >> 4u) & 0x0F0F0F0Fu) | (h0 & 0x30303030u),
+                            ((a1 >> 4u) & 0x0F0F0F0Fu) | (h1 & 0x30303030u), d0 * sbyte(sc01, od),
+                            d1 * sbyte(sc11, od), src1[xo0 + 16u], src1[xo1 + 16u]);
+            acc += q6k_step(((b0 >> 4u) & 0x0F0F0F0Fu) | ((h0 >> 2u) & 0x30303030u),
+                            ((b1 >> 4u) & 0x0F0F0F0Fu) | ((h1 >> 2u) & 0x30303030u), d0 * sbyte(sc01, 2u + od),
+                            d1 * sbyte(sc11, 2u + od), src1[xo0 + 24u], src1[xo1 + 24u]);
+        }
+    }
+    return acc;
+}
+#endif
+
+@compute @workgroup_size(LANES * LANES)
+fn main(@builtin(local_invocation_index) li: u32,
+        @builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let row_tiles = (params.m + TILE - 1u) / TILE;
+    let row0 = (wg_linear % row_tiles) * TILE + li % LANES;
+    let col0 = (wg_linear / row_tiles) * TILE + li / LANES;
+    let row1 = row0 + LANES;
+    let col1 = col0 + LANES;
+    // past the end: compute on the last row/column, store nothing
+    let rb0 = params.offset_src0 + min(row0, params.m - 1u) * params.stride_01;
+    let rb1 = params.offset_src0 + min(row1, params.m - 1u) * params.stride_01;
+    let xb0 = (params.offset_src1 + min(col0, params.n - 1u) * params.stride_11) / 4u;
+    let xb1 = (params.offset_src1 + min(col1, params.n - 1u) * params.stride_11) / 4u;
+
+    var acc = vec4<f32>(0.0);
+    let nb = params.k / 256u;
+    for (var b = 0u; b < nb; b++) {
+        acc += row_block_dot(rb0, rb1, b, xb0, xb1);
+    }
+
+    if (row0 < params.m && col0 < params.n) {
+        dst[params.offset_dst + col0 * params.m + row0] = acc.x;
+    }
+    if (row0 < params.m && col1 < params.n) {
+        dst[params.offset_dst + col1 * params.m + row0] = acc.y;
+    }
+    if (row1 < params.m && col0 < params.n) {
+        dst[params.offset_dst + col0 * params.m + row1] = acc.z;
+    }
+    if (row1 < params.m && col1 < params.n) {
+        dst[params.offset_dst + col1 * params.m + row1] = acc.w;
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_dequant.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_dequant.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_dequant.wgsl
@@ -0,0 +1,109 @@
+// Dequantizes Q4_K or Q6_K weights to f16, rows packed, for
+// mul_mat_pvr_gemm.wgsl (prompt batches on Imagination PowerVR GPUs). Each
+// thread writes 8 consecutive values; 32 threads cover a 256-value block.
+// They go to an rgba32uint texture, 8 values per texel and TEX_W texels per
+// texture row: PowerVR writes textures about 3 times faster than buffers,
+// and the product reads them faster too.
+
+struct Params {
+    offset_src0: u32,  // blocks
+    stride_01: u32,    // blocks between rows
+    m: u32,            // rows
+    k: u32             // values per row
+};
+
+#ifdef Q4_K
+@group(0) @binding(0) var<storage, read> src0: array<vec4<u32>>;
+#endif
+#ifdef Q6_K
+@group(0) @binding(0) var<storage, read> src0: array<u32>;
+#endif
+@group(0) @binding(1) var dst: texture_storage_2d<rgba32uint, write>;
+@group(0) @binding(2) var<uniform> params: Params;
+
+fn pack8(a: vec4<f32>, b: vec4<f32>) -> vec4<u32> {
+    return vec4<u32>(pack2x16float(a.xy), pack2x16float(a.zw), pack2x16float(b.xy), pack2x16float(b.zw));
+}
+
+#ifdef Q4_K
+// 144-byte blocks = 9 vec4<u32>: [0] = d, dmin, scales[12]; [1..8] = qs.
+// sub = 8 jj + t: values 64 jj + 32 (t / 4) + 8 (t % 4) .. + 7
+fn dequant8(blk: u32, sub: u32) -> vec4<u32> {
+    let bb = blk * 9u;
+    let h = src0[bb];
+    let dm = unpack2x16float(h.x);
+    let jj = sub / 8u;
+    let t = sub % 8u;
+    let s = 2u * jj + t / 4u;  // sub-block
+    let sh = 8u * (s & 3u);
+    var sc: u32;
+    var mn: u32;
+    if (s >= 4u) {
+        sc = ((h.w >> sh) & 0xFu) | (((h.y >> sh) >> 2u) & 0x30u);
+        mn = (((h.w >> sh) >> 4u) & 0xFu) | (((h.z >> sh) >> 2u) & 0x30u);
+    } else {
+        sc = (h.y >> sh) & 63u;
+        mn = (h.z >> sh) & 63u;
+    }
+    // qs bytes 32 jj + 8 (t % 4) .. + 7
+    let qv = src0[bb + 1u + 2u * jj + (t % 4u) / 2u];
+    var q0 = select(qv.x, qv.z, (t & 1u) == 1u);
+    var q1 = select(qv.y, qv.w, (t & 1u) == 1u);
+    if (t >= 4u) {
+        q0 = q0 >> 4u;
+        q1 = q1 >> 4u;
+    }
+    // unpack4x8unorm divides by 255
+    let a = dm.x * f32(sc) * 255.0;
+    let b = dm.y * f32(mn);
+    return pack8(unpack4x8unorm(q0 & 0x0F0F0F0Fu) * a - b, unpack4x8unorm(q1 & 0x0F0F0F0Fu) * a - b);
+}
+#endif
+
+#ifdef Q6_K
+// 210-byte blocks: ql[128], qh[64], scales[16] (i8), d (f16), only 2-byte aligned.
+
+// the 32-bit word at a 2-byte aligned byte offset
+fn ld(byte: u32) -> u32 {
+    let i = byte >> 2u;
+    let lo = src0[i];
+    let hi = src0[i + 1u];
+    return select((lo >> 16u) | (hi << 16u), lo, (byte & 2u) == 0u);
+}
+
+// sub = 16 n + 4 g + l0 / 8: values 128 n + 32 g + l0 .. + 7
+fn dequant8(blk: u32, sub: u32) -> vec4<u32> {
+    let base = blk * 210u;
+    let n = sub / 16u;
+    let g = (sub / 4u) % 4u;
+    let l0 = 8u * (sub % 4u);
+    let qlo = base + 64u * n + 32u * (g & 1u) + l0;
+    var ql0 = ld(qlo);
+    var ql1 = ld(qlo + 4u);
+    if (g >= 2u) {
+        ql0 = ql0 >> 4u;
+        ql1 = ql1 >> 4u;
+    }
+    let qho = base + 128u + 32u * n + l0;
+    let qsh = 2u * g;
+    let q0 = (ql0 & 0x0F0F0F0Fu) | (((ld(qho) >> qsh) & 0x03030303u) << 4u);
+    let q1 = (ql1 & 0x0F0F0F0Fu) | (((ld(qho + 4u) >> qsh) & 0x03030303u) << 4u);
+    let si = 8u * n + l0 / 16u + 2u * g;
+    let scw = ld(base + 192u + (si & ~1u));
+    let sc = f32(bitcast<i32>(scw << (24u - 8u * (si & 1u))) >> 24u);
+    let d = unpack2x16float(ld(base + 208u) & 0xFFFFu).x * sc;
+    return pack8((unpack4x8unorm(q0) * 255.0 - 32.0) * d, (unpack4x8unorm(q1) * 255.0 - 32.0) * d);
+}
+#endif
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let i = gid.y * num_wg.x * WG_SIZE + gid.x;  // index of the 8 values written
+    let per_row = params.k / 8u;
+    if (i >= params.m * per_row) {
+        return;
+    }
+    let row = i / per_row;
+    let c = i % per_row;
+    textureStore(dst, vec2<u32>(i % TEX_W, i / TEX_W), dequant8(params.offset_src0 + row * params.stride_01 + c / 32u, c % 32u));
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_gemm.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_gemm.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_gemm.wgsl
@@ -0,0 +1,416 @@
+// Mat-mat for prompt batches on Imagination PowerVR GPUs, on f16 weights
+// (mul_mat_pvr_dequant.wgsl, in a texture) and f16 activations
+// (mul_mat_pvr_stage.wgsl, OUT_F16, in a buffer bound read-only), both read 8
+// values at a time; the sums are f32. Workgroup memory tiles run slower
+// there: each thread computes 4 rows by 8 columns of dst straight from the
+// bindings, the 8 x 8 threads of a workgroup interleaving their rows and
+// columns by 8 (32 rows, 64 columns). The code is unrolled by hand, as loops
+// over arrays run slower there. About 800 GFLOPS on a Pixel 10 Pro.
+
+struct Params {
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    offset_glu: u32  // GLU: offset of the other operand
+};
+
+@group(0) @binding(0) var src0: texture_2d<u32>;                  // [m][k] f16, TEX_W texels per texture row
+@group(0) @binding(1) var<storage, read> src1: array<vec4<u32>>;  // [n][k] f16
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+#ifdef GLU
+// SwiGLU fused in: dst = silu(gate) * up, with this product the gate
+// (MM_IS_GATE) or the up operand, and the other operand read from glu
+@group(0) @binding(3) var<storage, read_write> glu: array<f32>;
+@group(0) @binding(4) var<uniform> params: Params;
+
+fn silu(x: f32) -> f32 {
+    return x / (1.0 + exp(-x));
+}
+
+// the value stored at dst index i (relative to offset_dst) for the sum a
+fn out(a: f32, i: u32) -> f32 {
+    let o = glu[params.offset_glu + i];
+#ifdef MM_IS_GATE
+    return silu(a) * o;
+#else
+    return silu(o) * a;
+#endif
+}
+#else
+@group(0) @binding(3) var<uniform> params: Params;
+#endif
+
+const LANES = 8u;
+const ROWS = 4u * LANES;
+const COLS = 8u * LANES;
+
+// the i-th 8 weights
+fn ld(i: u32) -> vec4<u32> {
+    return textureLoad(src0, vec2<u32>(i % TEX_W, i / TEX_W), 0);
+}
+
+fn lo(u: vec4<u32>) -> vec4<f32> {
+    return vec4<f32>(unpack2x16float(u.x), unpack2x16float(u.y));
+}
+
+fn hi(u: vec4<u32>) -> vec4<f32> {
+    return vec4<f32>(unpack2x16float(u.z), unpack2x16float(u.w));
+}
+
+@compute @workgroup_size(LANES * LANES)
+fn main(@builtin(local_invocation_index) li: u32,
+        @builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let row_tiles = (params.m + ROWS - 1u) / ROWS;
+    let r = (wg_linear % row_tiles) * ROWS + li % LANES;
+    let c = (wg_linear / row_tiles) * COLS + li / LANES;
+    let k8 = params.k / 8u;
+    // past the end: compute on the last row/column, store nothing
+    let w0 = min(r, params.m - 1u) * k8;
+    let w1 = min(r + LANES, params.m - 1u) * k8;
+    let w2 = min(r + 2u * LANES, params.m - 1u) * k8;
+    let w3 = min(r + 3u * LANES, params.m - 1u) * k8;
+    let x0 = min(c, params.n - 1u) * k8;
+    let x1 = min(c + LANES, params.n - 1u) * k8;
+    let x2 = min(c + 2u * LANES, params.n - 1u) * k8;
+    let x3 = min(c + 3u * LANES, params.n - 1u) * k8;
+    let x4 = min(c + 4u * LANES, params.n - 1u) * k8;
+    let x5 = min(c + 5u * LANES, params.n - 1u) * k8;
+    let x6 = min(c + 6u * LANES, params.n - 1u) * k8;
+    let x7 = min(c + 7u * LANES, params.n - 1u) * k8;
+
+    var s00 = 0.0; var s01 = 0.0; var s02 = 0.0; var s03 = 0.0; var s04 = 0.0; var s05 = 0.0; var s06 = 0.0; var s07 = 0.0;
+    var s10 = 0.0; var s11 = 0.0; var s12 = 0.0; var s13 = 0.0; var s14 = 0.0; var s15 = 0.0; var s16 = 0.0; var s17 = 0.0;
+    var s20 = 0.0; var s21 = 0.0; var s22 = 0.0; var s23 = 0.0; var s24 = 0.0; var s25 = 0.0; var s26 = 0.0; var s27 = 0.0;
+    var s30 = 0.0; var s31 = 0.0; var s32 = 0.0; var s33 = 0.0; var s34 = 0.0; var s35 = 0.0; var s36 = 0.0; var s37 = 0.0;
+    for (var kk = 0u; kk < k8; kk++) {
+        let u0 = ld(w0 + kk);
+        let l0 = lo(u0);
+        let h0 = hi(u0);
+        let u1 = ld(w1 + kk);
+        let l1 = lo(u1);
+        let h1 = hi(u1);
+        let u2 = ld(w2 + kk);
+        let l2 = lo(u2);
+        let h2 = hi(u2);
+        let u3 = ld(w3 + kk);
+        let l3 = lo(u3);
+        let h3 = hi(u3);
+        let v0 = src1[x0 + kk];
+        let xl0 = lo(v0);
+        let xh0 = hi(v0);
+        s00 += dot(l0, xl0) + dot(h0, xh0);
+        s10 += dot(l1, xl0) + dot(h1, xh0);
+        s20 += dot(l2, xl0) + dot(h2, xh0);
+        s30 += dot(l3, xl0) + dot(h3, xh0);
+        let v1 = src1[x1 + kk];
+        let xl1 = lo(v1);
+        let xh1 = hi(v1);
+        s01 += dot(l0, xl1) + dot(h0, xh1);
+        s11 += dot(l1, xl1) + dot(h1, xh1);
+        s21 += dot(l2, xl1) + dot(h2, xh1);
+        s31 += dot(l3, xl1) + dot(h3, xh1);
+        let v2 = src1[x2 + kk];
+        let xl2 = lo(v2);
+        let xh2 = hi(v2);
+        s02 += dot(l0, xl2) + dot(h0, xh2);
+        s12 += dot(l1, xl2) + dot(h1, xh2);
+        s22 += dot(l2, xl2) + dot(h2, xh2);
+        s32 += dot(l3, xl2) + dot(h3, xh2);
+        let v3 = src1[x3 + kk];
+        let xl3 = lo(v3);
+        let xh3 = hi(v3);
+        s03 += dot(l0, xl3) + dot(h0, xh3);
+        s13 += dot(l1, xl3) + dot(h1, xh3);
+        s23 += dot(l2, xl3) + dot(h2, xh3);
+        s33 += dot(l3, xl3) + dot(h3, xh3);
+        let v4 = src1[x4 + kk];
+        let xl4 = lo(v4);
+        let xh4 = hi(v4);
+        s04 += dot(l0, xl4) + dot(h0, xh4);
+        s14 += dot(l1, xl4) + dot(h1, xh4);
+        s24 += dot(l2, xl4) + dot(h2, xh4);
+        s34 += dot(l3, xl4) + dot(h3, xh4);
+        let v5 = src1[x5 + kk];
+        let xl5 = lo(v5);
+        let xh5 = hi(v5);
+        s05 += dot(l0, xl5) + dot(h0, xh5);
+        s15 += dot(l1, xl5) + dot(h1, xh5);
+        s25 += dot(l2, xl5) + dot(h2, xh5);
+        s35 += dot(l3, xl5) + dot(h3, xh5);
+        let v6 = src1[x6 + kk];
+        let xl6 = lo(v6);
+        let xh6 = hi(v6);
+        s06 += dot(l0, xl6) + dot(h0, xh6);
+        s16 += dot(l1, xl6) + dot(h1, xh6);
+        s26 += dot(l2, xl6) + dot(h2, xh6);
+        s36 += dot(l3, xl6) + dot(h3, xh6);
+        let v7 = src1[x7 + kk];
+        let xl7 = lo(v7);
+        let xh7 = hi(v7);
+        s07 += dot(l0, xl7) + dot(h0, xh7);
+        s17 += dot(l1, xl7) + dot(h1, xh7);
+        s27 += dot(l2, xl7) + dot(h2, xh7);
+        s37 += dot(l3, xl7) + dot(h3, xh7);
+    }
+
+    // stores written out flat: nested branches or a store helper run slower
+    if (r < params.m && c < params.n) {
+        let i = (c) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s00, i);
+#else
+        dst[params.offset_dst + i] = s00;
+#endif
+    }
+    if (r + LANES < params.m && c < params.n) {
+        let i = (c) * params.m + r + LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s10, i);
+#else
+        dst[params.offset_dst + i] = s10;
+#endif
+    }
+    if (r + 2u * LANES < params.m && c < params.n) {
+        let i = (c) * params.m + r + 2u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s20, i);
+#else
+        dst[params.offset_dst + i] = s20;
+#endif
+    }
+    if (r + 3u * LANES < params.m && c < params.n) {
+        let i = (c) * params.m + r + 3u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s30, i);
+#else
+        dst[params.offset_dst + i] = s30;
+#endif
+    }
+    if (r < params.m && c + LANES < params.n) {
+        let i = (c + LANES) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s01, i);
+#else
+        dst[params.offset_dst + i] = s01;
+#endif
+    }
+    if (r + LANES < params.m && c + LANES < params.n) {
+        let i = (c + LANES) * params.m + r + LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s11, i);
+#else
+        dst[params.offset_dst + i] = s11;
+#endif
+    }
+    if (r + 2u * LANES < params.m && c + LANES < params.n) {
+        let i = (c + LANES) * params.m + r + 2u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s21, i);
+#else
+        dst[params.offset_dst + i] = s21;
+#endif
+    }
+    if (r + 3u * LANES < params.m && c + LANES < params.n) {
+        let i = (c + LANES) * params.m + r + 3u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s31, i);
+#else
+        dst[params.offset_dst + i] = s31;
+#endif
+    }
+    if (r < params.m && c + 2u * LANES < params.n) {
+        let i = (c + 2u * LANES) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s02, i);
+#else
+        dst[params.offset_dst + i] = s02;
+#endif
+    }
+    if (r + LANES < params.m && c + 2u * LANES < params.n) {
+        let i = (c + 2u * LANES) * params.m + r + LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s12, i);
+#else
+        dst[params.offset_dst + i] = s12;
+#endif
+    }
+    if (r + 2u * LANES < params.m && c + 2u * LANES < params.n) {
+        let i = (c + 2u * LANES) * params.m + r + 2u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s22, i);
+#else
+        dst[params.offset_dst + i] = s22;
+#endif
+    }
+    if (r + 3u * LANES < params.m && c + 2u * LANES < params.n) {
+        let i = (c + 2u * LANES) * params.m + r + 3u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s32, i);
+#else
+        dst[params.offset_dst + i] = s32;
+#endif
+    }
+    if (r < params.m && c + 3u * LANES < params.n) {
+        let i = (c + 3u * LANES) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s03, i);
+#else
+        dst[params.offset_dst + i] = s03;
+#endif
+    }
+    if (r + LANES < params.m && c + 3u * LANES < params.n) {
+        let i = (c + 3u * LANES) * params.m + r + LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s13, i);
+#else
+        dst[params.offset_dst + i] = s13;
+#endif
+    }
+    if (r + 2u * LANES < params.m && c + 3u * LANES < params.n) {
+        let i = (c + 3u * LANES) * params.m + r + 2u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s23, i);
+#else
+        dst[params.offset_dst + i] = s23;
+#endif
+    }
+    if (r + 3u * LANES < params.m && c + 3u * LANES < params.n) {
+        let i = (c + 3u * LANES) * params.m + r + 3u * LANES;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s33, i);
+#else
+        dst[params.offset_dst + i] = s33;
+#endif
+    }
+    if (r < params.m && c + 4u * LANES < params.n) {
+        let i = (c + 4u * LANES) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s04, i);
+#else
+        dst[params.offset_dst + i] = s04;
