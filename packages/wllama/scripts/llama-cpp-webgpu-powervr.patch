+        dispatches.push_back({
+            stage_pipeline, std::move(stage_params), std::move(stage_entries),
+            { CEIL_DIV(per_column, WEBGPU_MUL_MAT_PVR_STAGE_WG_SIZE), n }
+        });
+    }
