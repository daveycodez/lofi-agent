+    const ggml_tensor * staged = ctx->pvr_staged_src1;
+    const bool reuse_staged = staged != nullptr && ctx->pvr_staged_f16 == gemm &&
+                              ggml_webgpu_tensor_buf(staged).Get() == ggml_webgpu_tensor_buf(src1).Get() &&
+                              ggml_webgpu_tensor_offset(staged) == ggml_webgpu_tensor_offset(src1) &&
+                              staged->ne[0] == src1->ne[0] && staged->ne[1] == src1->ne[1] && staged->nb[1] == src1->nb[1];
+    ctx->pvr_staged_src1 = src1;
+    ctx->pvr_staged_f16  = gemm;
