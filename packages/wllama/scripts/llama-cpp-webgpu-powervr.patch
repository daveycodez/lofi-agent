new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/flash_attn_pvr.wgsl
@@ -0,0 +1,121 @@
+// Flash attention for one query token on Imagination PowerVR GPUs (f32 Q,
+// f16 K/V). The generic vector path takes milliseconds per call there. One
+// workgroup per query head: each thread walks every WG_SIZE-th KV position
+// with its own running max, sum and output, then the threads merge them.
+// K and V are bound read-only when they live in another buffer than dst (the
+// KV cache), as PowerVR reads read_write bindings much slower.
+
+enable f16;
+
+struct Params {
+    offset_q: u32,
+    offset_k: u32,
+    offset_v: u32,
+    offset_mask: u32,
+    offset_dst: u32,
+    n_kv: u32,
+    stride_q2: u32,   // Q elements between heads
+    stride_k1: u32,   // K elements between KV positions
+    stride_k2: u32,   // K elements between KV heads
+    stride_v1: u32,
+    stride_v2: u32,
+    head_ratio: u32,  // query heads per KV head
+    scale: f32
+};
+
+#ifdef KV_RO
+#define KV_ACCESS read
+#else
+#define KV_ACCESS read_write
+#endif
+
+@group(0) @binding(0) var<storage, read_write> q: array<f32>;
+@group(0) @binding(1) var<storage, KV_ACCESS> k: array<vec4<f16>>;
+@group(0) @binding(2) var<storage, KV_ACCESS> v: array<vec4<f16>>;
+#ifdef HAS_MASK
+@group(0) @binding(3) var<storage, read_write> mask: array<f16>;
+#define DST_BINDING 4
+#else
+#define DST_BINDING 3
+#endif
+@group(0) @binding(DST_BINDING) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(DST_BINDING + 1) var<uniform> params: Params;
+
+const D4 = HEAD_DIM / 4u;
+const NEG_BIG = -3.0e38;
+
+var<workgroup> sh_m: array<f32, WG_SIZE>;
+var<workgroup> sh_l: array<f32, WG_SIZE>;
+var<workgroup> sh_o: array<vec4<f32>, WG_SIZE * D4>;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
+    let h = wg_id.x;
+    let kvh = h / params.head_ratio;
+
+    var qv: array<vec4<f32>, D4>;
+    let q_base = params.offset_q + h * params.stride_q2;
+    for (var i = 0u; i < D4; i++) {
+        qv[i] = vec4<f32>(q[q_base + 4u * i], q[q_base + 4u * i + 1u], q[q_base + 4u * i + 2u], q[q_base + 4u * i + 3u]) *
+                params.scale;
+    }
+
+    var m = NEG_BIG;
+    var l = 0.0;
+    var o: array<vec4<f32>, D4>;
+    for (var i = 0u; i < D4; i++) {
+        o[i] = vec4<f32>(0.0);
+    }
+
+    let k_head = (params.offset_k + kvh * params.stride_k2) / 4u;
+    let v_head = (params.offset_v + kvh * params.stride_v2) / 4u;
+    for (var j = lid; j < params.n_kv; j += WG_SIZE) {
+        let kb = k_head + j * (params.stride_k1 / 4u);
+        var s = 0.0;
+        for (var i = 0u; i < D4; i++) {
+            s += dot(qv[i], vec4<f32>(k[kb + i]));
+        }
+#ifdef HAS_MASK
+        s += f32(mask[params.offset_mask + j]);
+#endif
+        if (s > NEG_BIG) {
+            let m_new = max(m, s);
+            let corr = exp(m - m_new);
+            let p = exp(s - m_new);
+            l = l * corr + p;
+            let vb = v_head + j * (params.stride_v1 / 4u);
+            for (var i = 0u; i < D4; i++) {
+                o[i] = o[i] * corr + p * vec4<f32>(v[vb + i]);
+            }
+            m = m_new;
+        }
+    }
+
+    // merge the threads
+    sh_m[lid] = m;
+    workgroupBarrier();
+    var m_all = NEG_BIG;
+    for (var t = 0u; t < WG_SIZE; t++) {
+        m_all = max(m_all, sh_m[t]);
+    }
+    let f = select(exp(m - m_all), 0.0, m <= NEG_BIG);
+    sh_l[lid] = l * f;
+    for (var i = 0u; i < D4; i++) {
+        sh_o[lid * D4 + i] = o[i] * f;
+    }
+    workgroupBarrier();
+    if (lid < D4) {
+        var l_all = 0.0;
+        var acc = vec4<f32>(0.0);
+        for (var t = 0u; t < WG_SIZE; t++) {
+            l_all += sh_l[t];
+            acc += sh_o[t * D4 + lid];
+        }
+        let r = acc / l_all;
+        let d = params.offset_dst + h * HEAD_DIM + 4u * lid;
+        dst[d] = r.x;
+        dst[d + 1u] = r.y;
+        dst[d + 2u] = r.z;
+        dst[d + 3u] = r.w;
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr.wgsl
@@ -0,0 +1,215 @@
+// Mat-mat (prompt batches) for Imagination PowerVR GPUs (Q4_K, Q6_K).
+//
+// The tiled shaders stage both operands in workgroup memory, which is slow
+// there, and read through read_write bindings, which PowerVR reads several
+// times slower than read-only ones. Here each thread computes a 2x2 block of
+// dst straight from read-only bindings: the weights (SRC0_RO, when they are
+// in another buffer than dst) and a copy of src1 (mul_mat_pvr_stage.wgsl).
+// The 8x8 threads of a workgroup cover 16 rows and 16 columns, rows and
+// columns interleaved by 8. Larger blocks per thread run slower.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_RO
+#define SRC0_ACCESS read
+#else
+#define SRC0_ACCESS read_write
+#endif
+
+#ifdef Q4_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<vec4<u32>>;
+#endif
+#ifdef Q6_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<u32>;
+#endif
+@group(0) @binding(1) var<storage, read> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const LANES = 8u;          // threads along rows and along columns
+const TILE = 2u * LANES;   // rows (and columns) per workgroup
+
+#ifdef Q4_K
+// 144-byte blocks = 9 vec4<u32>: [0] = d, dmin, scales[12]; [1..8] = qs.
+
+// d * scale * 255 and dmin * min of sub-blocks 2jj (xy) and 2jj + 1 (zw)
+fn q4k_scales(h: vec4<u32>, jj: u32) -> vec4<f32> {
+    let dm = unpack2x16float(h.x);
+    let A = h.y;
+    let B = h.z;
+    let C = h.w;
+    let s = 2u * jj;
+    let sha = 8u * (s & 3u);
+    let shb = sha + 8u;
+    var sc1: u32;
+    var m1: u32;
+    var sc2: u32;
+    var m2: u32;
+    if (s >= 4u) {
+        sc1 = ((C >> sha) & 0xFu) | (((A >> sha) >> 2u) & 0x30u);
+        m1  = (((C >> sha) >> 4u) & 0xFu) | (((B >> sha) >> 2u) & 0x30u);
+        sc2 = ((C >> shb) & 0xFu) | (((A >> shb) >> 2u) & 0x30u);
+        m2  = (((C >> shb) >> 4u) & 0xFu) | (((B >> shb) >> 2u) & 0x30u);
+    } else {
+        sc1 = (A >> sha) & 63u;
+        m1  = (B >> sha) & 63u;
+        sc2 = (A >> shb) & 63u;
+        m2  = (B >> shb) & 63u;
+    }
+    // unpack4x8unorm divides by 255
+    return vec4<f32>(dm.x * f32(sc1) * 255.0, dm.y * f32(m1), dm.x * f32(sc2) * 255.0, dm.y * f32(m2));
+}
+
+// one qs word of rows 0 and 1 (4 low-nibble and 4 high-nibble values each)
+// against 4 + 4 values of columns 0 and 1: deltas for (r0c0, r0c1, r1c0, r1c1)
+fn q4k_step(qa: u32, qb: u32, s0: vec4<f32>, s1: vec4<f32>, xl0: vec4<f32>, xh0: vec4<f32>, xl1: vec4<f32>,
+            xh1: vec4<f32>) -> vec4<f32> {
+    let wl0 = unpack4x8unorm(qa & 0x0F0F0F0Fu) * s0.x - s0.y;
+    let wh0 = unpack4x8unorm((qa >> 4u) & 0x0F0F0F0Fu) * s0.z - s0.w;
+    let wl1 = unpack4x8unorm(qb & 0x0F0F0F0Fu) * s1.x - s1.y;
+    let wh1 = unpack4x8unorm((qb >> 4u) & 0x0F0F0F0Fu) * s1.z - s1.w;
+    return vec4<f32>(dot(wl0, xl0) + dot(wh0, xh0), dot(wl0, xl1) + dot(wh0, xh1), dot(wl1, xl0) + dot(wh1, xh0),
+                     dot(wl1, xl1) + dot(wh1, xh1));
+}
+
+fn row_block_dot(rb0: u32, rb1: u32, b: u32, xb0: u32, xb1: u32) -> vec4<f32> {
+    let bb0 = (rb0 + b) * 9u;
+    let bb1 = (rb1 + b) * 9u;
+    let h0 = src0[bb0];
+    let h1 = src0[bb1];
+    var acc = vec4<f32>(0.0);
+    for (var p = 0u; p < 8u; p++) {
+        let jj = p >> 1u;
+        let q0 = src0[bb0 + 1u + p];
+        let q1 = src0[bb1 + 1u + p];
+        let s0 = q4k_scales(h0, jj);
+        let s1 = q4k_scales(h1, jj);
+        // qs bytes 16p..16p+15: values 64jj + l (low nibbles) and 64jj + 32 + l (high)
+        let xo0 = xb0 + b * 64u + jj * 16u + (p & 1u) * 4u;
+        let xo1 = xb1 + b * 64u + jj * 16u + (p & 1u) * 4u;
+        acc += q4k_step(q0.x, q1.x, s0, s1, src1[xo0], src1[xo0 + 8u], src1[xo1], src1[xo1 + 8u]);
+        acc += q4k_step(q0.y, q1.y, s0, s1, src1[xo0 + 1u], src1[xo0 + 9u], src1[xo1 + 1u], src1[xo1 + 9u]);
+        acc += q4k_step(q0.z, q1.z, s0, s1, src1[xo0 + 2u], src1[xo0 + 10u], src1[xo1 + 2u], src1[xo1 + 10u]);
+        acc += q4k_step(q0.w, q1.w, s0, s1, src1[xo0 + 3u], src1[xo0 + 11u], src1[xo1 + 3u], src1[xo1 + 11u]);
+    }
+    return acc;
+}
+#endif
+
+#ifdef Q6_K
+// 210-byte blocks: ql[128], qh[64], scales[16] (i8), d (f16), only 2-byte aligned.
+
+// the 32-bit word at a 2-byte aligned byte offset
+fn ld(byte: u32) -> u32 {
+    let i = byte >> 2u;
+    let lo = src0[i];
+    let hi = src0[i + 1u];
+    return select((lo >> 16u) | (hi << 16u), lo, (byte & 2u) == 0u);
+}
+
+fn sbyte(w: u32, i: u32) -> f32 {
+    return f32(bitcast<i32>(w << (24u - 8u * i)) >> 24u);
+}
+
+// 4 values (6 bits, biased by 32) of rows 0 and 1 against 4 values of
+// columns 0 and 1, with scales s0 and s1 (times d): (r0c0, r0c1, r1c0, r1c1)
+fn q6k_step(qa: u32, qb: u32, s0: f32, s1: f32, x0: vec4<f32>, x1: vec4<f32>) -> vec4<f32> {
+    let w0 = (unpack4x8unorm(qa) * 255.0 - 32.0) * s0;
+    let w1 = (unpack4x8unorm(qb) * 255.0 - 32.0) * s1;
+    return vec4<f32>(dot(w0, x0), dot(w0, x1), dot(w1, x0), dot(w1, x1));
+}
+
+fn row_block_dot(rb0: u32, rb1: u32, b: u32, xb0: u32, xb1: u32) -> vec4<f32> {
+    let base0 = (rb0 + b) * 210u;
+    let base1 = (rb1 + b) * 210u;
+    let d0 = unpack2x16float(ld(base0 + 208u) & 0xFFFFu).x;
+    let d1 = unpack2x16float(ld(base1 + 208u) & 0xFFFFu).x;
+    var acc = vec4<f32>(0.0);
+    for (var n = 0u; n < 2u; n++) {
+        // scales 8n .. 8n + 7
+        let sc00 = ld(base0 + 192u + 8u * n);
+        let sc01 = ld(base0 + 196u + 8u * n);
+        let sc10 = ld(base1 + 192u + 8u * n);
+        let sc11 = ld(base1 + 196u + 8u * n);
+        for (var w = 0u; w < 8u; w++) {
+            let l0 = 4u * w;
+            let od = w >> 2u;  // l0 / 16
+            let a0 = ld(base0 + 64u * n + l0);
+            let b0 = ld(base0 + 64u * n + l0 + 32u);
+            let h0 = ld(base0 + 128u + 32u * n + l0);
+            let a1 = ld(base1 + 64u * n + l0);
+            let b1 = ld(base1 + 64u * n + l0 + 32u);
+            let h1 = ld(base1 + 128u + 32u * n + l0);
+            let xo0 = xb0 + b * 64u + 32u * n + w;
+            let xo1 = xb1 + b * 64u + 32u * n + w;
+            // y[l], y[l + 32], y[l + 64], y[l + 96] of this half
+            acc += q6k_step((a0 & 0x0F0F0F0Fu) | ((h0 << 4u) & 0x30303030u),
+                            (a1 & 0x0F0F0F0Fu) | ((h1 << 4u) & 0x30303030u), d0 * sbyte(sc00, od),
+                            d1 * sbyte(sc10, od), src1[xo0], src1[xo1]);
+            acc += q6k_step((b0 & 0x0F0F0F0Fu) | ((h0 << 2u) & 0x30303030u),
+                            (b1 & 0x0F0F0F0Fu) | ((h1 << 2u) & 0x30303030u), d0 * sbyte(sc00, 2u + od),
+                            d1 * sbyte(sc10, 2u + od), src1[xo0 + 8u], src1[xo1 + 8u]);
+            acc += q6k_step(((a0 >> 4u) & 0x0F0F0F0Fu) | (h0 & 0x30303030u),
+                            ((a1 >> 4u) & 0x0F0F0F0Fu) | (h1 & 0x30303030u), d0 * sbyte(sc01, od),
+                            d1 * sbyte(sc11, od), src1[xo0 + 16u], src1[xo1 + 16u]);
+            acc += q6k_step(((b0 >> 4u) & 0x0F0F0F0Fu) | ((h0 >> 2u) & 0x30303030u),
+                            ((b1 >> 4u) & 0x0F0F0F0Fu) | ((h1 >> 2u) & 0x30303030u), d0 * sbyte(sc01, 2u + od),
+                            d1 * sbyte(sc11, 2u + od), src1[xo0 + 24u], src1[xo1 + 24u]);
+        }
+    }
+    return acc;
+}
+#endif
+
+@compute @workgroup_size(LANES * LANES)
+fn main(@builtin(local_invocation_index) li: u32,
+        @builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let row_tiles = (params.m + TILE - 1u) / TILE;
+    let row0 = (wg_linear % row_tiles) * TILE + li % LANES;
+    let col0 = (wg_linear / row_tiles) * TILE + li / LANES;
+    let row1 = row0 + LANES;
+    let col1 = col0 + LANES;
+    // past the end: compute on the last row/column, store nothing
+    let rb0 = params.offset_src0 + min(row0, params.m - 1u) * params.stride_01;
+    let rb1 = params.offset_src0 + min(row1, params.m - 1u) * params.stride_01;
+    let xb0 = (params.offset_src1 + min(col0, params.n - 1u) * params.stride_11) / 4u;
+    let xb1 = (params.offset_src1 + min(col1, params.n - 1u) * params.stride_11) / 4u;
+
+    var acc = vec4<f32>(0.0);
+    let nb = params.k / 256u;
+    for (var b = 0u; b < nb; b++) {
+        acc += row_block_dot(rb0, rb1, b, xb0, xb1);
+    }
+
+    if (row0 < params.m && col0 < params.n) {
+        dst[params.offset_dst + col0 * params.m + row0] = acc.x;
+    }
+    if (row0 < params.m && col1 < params.n) {
+        dst[params.offset_dst + col1 * params.m + row0] = acc.y;
+    }
+    if (row1 < params.m && col0 < params.n) {
+        dst[params.offset_dst + col0 * params.m + row1] = acc.z;
+    }
+    if (row1 < params.m && col1 < params.n) {
+        dst[params.offset_dst + col1 * params.m + row1] = acc.w;
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_pvr_stage.wgsl
@@ -0,0 +1,21 @@
+// Copies the src1 of a mat-vec or mat-mat into a buffer of its own, columns
+// packed, so that mul_mat_vec_pvr.wgsl and mul_mat_pvr.wgsl can bind it
+// read-only (see there).
+
+struct Params {
+    offset_src: u32,
+    k: u32,
+    stride_src: u32,  // elements between columns
+    n: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src: array<f32>;
+@group(0) @binding(1) var<storage, read_write> staged: array<f32>;
+@group(0) @binding(2) var<uniform> params: Params;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    if (gid.x < params.k && gid.y < params.n) {
+        staged[gid.y * params.k + gid.x] = src[params.offset_src + gid.y * params.stride_src + gid.x];
+    }
+}
diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_pvr.wgsl
@@ -0,0 +1,186 @@
+// Mat-vec for Imagination PowerVR GPUs (Q4_K, Q6_K, one column).
+//
+// On these GPUs, reading through a read_write storage binding is several
+// times slower than through a read-only one, so the weights are bound
+// read-only (SRC0_RO, when they sit in a different buffer than dst) and the
+// vector is read from a read-only copy (mul_mat_pvr_stage.wgsl). Each
+// group of TPR threads handles one row, and neighbouring lanes load
+// neighbouring 16-byte words of a block.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_RO
+#define SRC0_ACCESS read
+#else
+#define SRC0_ACCESS read_write
+#endif
+
+#ifdef Q4_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<vec4<u32>>;
+#endif
+#ifdef Q6_K
+@group(0) @binding(0) var<storage, SRC0_ACCESS> src0: array<u32>;
+#endif
+@group(0) @binding(1) var<storage, read> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const TPR = WG_SIZE / ROWS_PER_WG;
+
+var<workgroup> partial_sums: array<f32, WG_SIZE>;
+
+#ifdef Q4_K
+// 144-byte blocks = 9 vec4<u32>: [0] = d, dmin, scales[12]; [1..8] = qs.
+// LPB lanes share a block; a lane handles qs words pg and pg + 4.
+const LPB = 4u;
+
+fn q4k_piece(bb: u32, xb: u32, p: u32, A: u32, B: u32, C: u32, dm: vec2<f32>) -> f32 {
+    let q = src0[bb + 1u + p];
+    let jj = p >> 1u;
+    let xo = xb + jj * 16u + (p & 1u) * 4u;
+    let xl0 = src1[xo];
+    let xl1 = src1[xo + 1u];
+    let xl2 = src1[xo + 2u];
+    let xl3 = src1[xo + 3u];
+    let xh0 = src1[xo + 8u];
+    let xh1 = src1[xo + 9u];
+    let xh2 = src1[xo + 10u];
+    let xh3 = src1[xo + 11u];
+    let sl = unpack4x8unorm(q.x & 0x0F0F0F0Fu) * xl0 + unpack4x8unorm(q.y & 0x0F0F0F0Fu) * xl1 +
+             unpack4x8unorm(q.z & 0x0F0F0F0Fu) * xl2 + unpack4x8unorm(q.w & 0x0F0F0F0Fu) * xl3;
+    let sh = unpack4x8unorm((q.x >> 4u) & 0x0F0F0F0Fu) * xh0 + unpack4x8unorm((q.y >> 4u) & 0x0F0F0F0Fu) * xh1 +
+             unpack4x8unorm((q.z >> 4u) & 0x0F0F0F0Fu) * xh2 + unpack4x8unorm((q.w >> 4u) & 0x0F0F0F0Fu) * xh3;
+    let sum_l = xl0 + xl1 + xl2 + xl3;
+    let sum_h = xh0 + xh1 + xh2 + xh3;
+    // scales and mins of sub-blocks 2jj (low nibbles) and 2jj + 1 (high nibbles)
+    let s = 2u * jj;
+    let sha = 8u * (s & 3u);
+    let shb = sha + 8u;
+    var sc1: u32;
+    var m1: u32;
+    var sc2: u32;
+    var m2: u32;
+    if (s >= 4u) {
+        sc1 = ((C >> sha) & 0xFu) | (((A >> sha) >> 2u) & 0x30u);
+        m1  = (((C >> sha) >> 4u) & 0xFu) | (((B >> sha) >> 2u) & 0x30u);
+        sc2 = ((C >> shb) & 0xFu) | (((A >> shb) >> 2u) & 0x30u);
+        m2  = (((C >> shb) >> 4u) & 0xFu) | (((B >> shb) >> 2u) & 0x30u);
+    } else {
+        sc1 = (A >> sha) & 63u;
+        m1  = (B >> sha) & 63u;
+        sc2 = (A >> shb) & 63u;
+        m2  = (B >> shb) & 63u;
+    }
+    let one = vec4<f32>(1.0);
+    // unpack4x8unorm divides by 255
+    return dm.x * 255.0 * (f32(sc1) * dot(sl, one) + f32(sc2) * dot(sh, one)) -
+           dm.y * (f32(m1) * dot(sum_l, one) + f32(m2) * dot(sum_h, one));
+}
+
+fn block_dot(row_block: u32, b: u32, xb: u32, pg: u32) -> f32 {
+    let bb = (row_block + b) * 9u;
+    let hdr = src0[bb];
+    let dm = unpack2x16float(hdr.x);
+    return q4k_piece(bb, xb, pg, hdr.y, hdr.z, hdr.w, dm) + q4k_piece(bb, xb, pg + 4u, hdr.y, hdr.z, hdr.w, dm);
+}
+#endif
+
+#ifdef Q6_K
+// 210-byte blocks: ql[128], qh[64], scales[16] (i8), d (f16). Blocks are only
+// 2-byte aligned. 8 lanes share a block, each handling 32 values.
+const LPB = 8u;
+
+// the 32-bit word at a 2-byte aligned byte offset
+fn ld(byte: u32) -> u32 {
+    let i = byte >> 2u;
+    let lo = src0[i];
+    let hi = src0[i + 1u];
+    return select((lo >> 16u) | (hi << 16u), lo, (byte & 2u) == 0u);
+}
+
+fn sbyte(w: u32, i: u32) -> f32 {
+    return f32(bitcast<i32>(w << (24u - 8u * i)) >> 24u);
+}
+
+// 4 values (6-bit, biased by 32) times 4 x values
+fn grp(q: u32, x: vec4<f32>) -> f32 {
+    return dot(unpack4x8unorm(q), x) * 255.0 - 32.0 * (x.x + x.y + x.z + x.w);
+}
+
+fn block_dot(row_block: u32, b: u32, xb: u32, p: u32) -> f32 {
+    let base = (row_block + b) * 210u;
+    let n = p >> 2u;
+    let l0 = 8u * (p & 3u);
+    let a0 = ld(base + 64u * n + l0);
+    let a1 = ld(base + 64u * n + l0 + 4u);
+    let b0 = ld(base + 64u * n + l0 + 32u);
+    let b1 = ld(base + 64u * n + l0 + 36u);
+    let h0 = ld(base + 128u + 32u * n + l0);
+    let h1 = ld(base + 132u + 32u * n + l0);
+    let scw0 = ld(base + 192u + 8u * n);
+    let scw1 = ld(base + 196u + 8u * n);
+    let od = l0 >> 4u;
+    let d = unpack2x16float(ld(base + 208u) & 0xFFFFu).x;
+    let x0 = xb + 32u * n + (l0 >> 2u);
+    var r = sbyte(scw0, od) * (grp((a0 & 0x0F0F0F0Fu) | ((h0 << 4u) & 0x30303030u), src1[x0]) +
+                               grp((a1 & 0x0F0F0F0Fu) | ((h1 << 4u) & 0x30303030u), src1[x0 + 1u]));
+    r += sbyte(scw0, 2u + od) * (grp((b0 & 0x0F0F0F0Fu) | ((h0 << 2u) & 0x30303030u), src1[x0 + 8u]) +
+                                 grp((b1 & 0x0F0F0F0Fu) | ((h1 << 2u) & 0x30303030u), src1[x0 + 9u]));
+    r += sbyte(scw1, od) * (grp(((a0 >> 4u) & 0x0F0F0F0Fu) | (h0 & 0x30303030u), src1[x0 + 16u]) +
+                            grp(((a1 >> 4u) & 0x0F0F0F0Fu) | (h1 & 0x30303030u), src1[x0 + 17u]));
+    r += sbyte(scw1, 2u + od) * (grp(((b0 >> 4u) & 0x0F0F0F0Fu) | ((h0 >> 2u) & 0x30303030u), src1[x0 + 24u]) +
+                                 grp(((b1 >> 4u) & 0x0F0F0F0Fu) | ((h1 >> 2u) & 0x30303030u), src1[x0 + 25u]));
+    return d * r;
+}
+#endif
+
+const BLOCKS_PER_ITER = TPR / LPB;
+const_assert BLOCKS_PER_ITER > 0u;
+
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(local_invocation_index) li: u32,
+        @builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let t = li % TPR;
+    let row = wg_linear * ROWS_PER_WG + li / TPR;
+    let nb = params.k / 256u;
+    // rows past the end compute on the last row and store nothing
+    let row_block = params.offset_src0 + min(row, params.m - 1u) * params.stride_01;
+    let x0 = params.offset_src1 / 4u;
+    let lane = t % LPB;
+
+    var acc = 0.0;
+    for (var b = t / LPB; b < nb; b += BLOCKS_PER_ITER) {
+        acc += block_dot(row_block, b, x0 + b * 64u, lane);
+    }
+
+    partial_sums[li] = acc;
+    workgroupBarrier();
+    for (var s = TPR / 2u; s > 0u; s >>= 1u) {
+        if (t < s) {
+            partial_sums[li] += partial_sums[li + s];
+        }
+        workgroupBarrier();
+    }
+    if (t == 0u && row < params.m) {
+        dst[params.offset_dst + row] = partial_sums[li];
+    }
+}
