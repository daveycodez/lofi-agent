{
  "name": "@tanstack-ai-browser/apfel",
  "version": "0.0.1",
  "description": "TanStack AI adapter for Apple's on-device Foundation Model, served by apfel",
  "license": "MIT",
  "author": "daveycodez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daveycodez/tanstack-ai-browser.git",
    "directory": "packages/apfel"
  },
  "homepage": "https://github.com/daveycodez/tanstack-ai-browser/tree/main/packages/apfel#readme",
  "bugs": "https://github.com/daveycodez/tanstack-ai-browser/issues",
  "keywords": [
    "tanstack-ai",
    "tanstack",
    "ai",
    "llm",
    "apple",
    "foundation-models",
    "apfel",
    "on-device",
    "local-ai"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tanstack-ai-browser/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "apfel"
  },
  "peerDependencies": {
    "@tanstack/ai": "^1.0.0"
  },
  "devDependencies": {
    "@tanstack/ai": "1.0.0"
  }
}
