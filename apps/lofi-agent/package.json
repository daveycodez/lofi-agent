{
  "name": "@tanstack-ai-browser/lofi-agent",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.23.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack-ai-browser/apfel": "workspace:*",
    "@tanstack-ai-browser/prompt-api": "workspace:*",
    "@tanstack-ai-browser/transformers-js": "workspace:*",
    "@tanstack-ai-browser/wllama": "workspace:*",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-client": "1.0.0",
    "@tanstack/ai-mcp": "1.0.0",
    "@tanstack/ai-react": "1.0.0",
    "@tanstack/highlight": "1.2.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "katex": "^0.16.47",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tanstack-markdown-math": "1.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-ai-devtools": "1.0.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "nx": {
    "name": "lofi-agent",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "deploy": {
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "command": "tsc --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  }
}
